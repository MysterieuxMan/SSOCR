# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Azure Entra ID / Microsoft Graph (Option 1: Client Credentials Flow - Headless)
# Dapatkan nilai ini dari App Registration di Azure Portal (portal.azure.com)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Target Excel Table Configuration (Optional Defaults)
EXCEL_DEFAULT_DRIVE_ID=
EXCEL_DEFAULT_ITEM_ID=
EXCEL_DEFAULT_TABLE_NAME=WeighingTable
EXCEL_DEFAULT_USER_EMAIL=
